#: ../src/xz/xz.1
#, no-wrap
msgid "64 KiB"
msgstr "64 KiB"

#. type: tbl table
#: ../src/xz/xz.1
#, no-wrap
msgid "512 KiB"
msgstr "512 KiB"

#. type: Plain text
#: ../src/xz/xz.1
msgid "The dictionary size differences affect the compressor memory usage too, but there are some other differences between LZMA Utils and XZ Utils, which make the difference even bigger:"
msgstr "Vārdnīcas izmēra atšķirības ietekmē arī saspiedēja atmiņas lietojumu, taču starp LZMA Utils un XZ Utils ir arī citas atšķirības, kas padara šo starpību vēl lielāku:"

#. type: tbl table
