#. type: TH
#: ../src/xzdec/xzdec.1
#, no-wrap
msgid "XZDEC"
msgstr "XZDEC"

#. type: TH
#: ../src/xzdec/xzdec.1
#, no-wrap
msgid "2024-04-08"
msgstr "2024-04-08"

#. type: Plain text
#: ../src/xzdec/xzdec.1
msgid "xzdec, lzmadec - Small .xz and .lzma decompressors"
msgstr "xzdec, lzmadec - mazi .xz un .lzma atspiešanas rīki"

#. type: Plain text
#: ../src/xzdec/xzdec.1
msgid "B<xzdec> [I<option...>] [I<file...>]"
msgstr "B<xzdec> [I<opcija...>] [I<fails...>]"

#. type: Plain text
#: ../src/xzdec/xzdec.1
msgid "B<lzmadec> [I<option...>] [I<file...>]"
msgstr "B<lzmadec> [I<opcija...>] [I<fails...>]"

#. type: Plain text
#: ../src/xzdec/xzdec.1
msgid "B<xzdec> is a liblzma-based decompression-only tool for B<.xz> (and only B<.xz>)  files.  B<xzdec> is intended to work as a drop-in replacement for B<xz>(1)  in the most common situations where a script has been written to use B<xz --decompress --stdout> (and possibly a few other commonly used options) to decompress B<.xz> files.  B<lzmadec> is identical to B<xzdec> except that B<lzmadec> supports B<.lzma> files instead of B<.xz> files."
msgstr "B<xzdec> ir uz liblzma balstīts rīks, kas paredzēts tikai B<.xz> (un tikai B<.xz>) failu atspiešanai. B<xzdec> ir paredzēts kā tiešs aizstājējs programmai B<xz>(1) visbiežāk sastopamajās situācijās, kad skripts ir uzrakstīts, lai izmantotu B<xz --decompress --stdout> (un, iespējams, dažus citus bieži lietotus parametrus) B<.xz> failu atspiešanai. B<lzmadec> ir identisks B<xzdec>, izņemot to, ka B<lzmadec> atbalsta B<.lzma> failus, nevis B<.xz> failus."

#. type: Plain text
#: ../src/xzdec/xzdec.1
msgid "To reduce the size of the executable, B<xzdec> doesn't support multithreading or localization, and doesn't read options from B<XZ_DEFAULTS> and B<XZ_OPT> environment variables.  B<xzdec> doesn't support displaying intermediate progress information: sending B<SIGINFO> to B<xzdec> does nothing, but sending B<SIGUSR1> terminates the process instead of displaying progress information."
msgstr "Lai samazinātu izpildāmā faila izmēru, B<xzdec> neatbalsta daudzpavedienu darbību vai lokalizāciju un nelasa parametrus no B<XZ_DEFAULTS> un B<XZ_OPT> vides mainīgajiem. B<xzdec> neatbalsta starpposma progresa informācijas attēlošanu: B<SIGINFO> nosūtīšana B<xzdec> neko nedara, bet B<SIGUSR1> nosūtīšana pārtrauc procesu, nevis parāda progresa informāciju."

#. type: Plain text
#: ../src/xzdec/xzdec.1
msgid "Ignored for B<xz>(1)  compatibility.  B<xzdec> supports only decompression."
msgstr "Ignorēts saderībai ar B<xz>(1). B<xzdec> atbalsta tikai atspiešanu."

#. type: Plain text
#: ../src/xzdec/xzdec.1
msgid "Ignored for B<xz>(1)  compatibility.  B<xzdec> never creates or removes any files."
msgstr "Ignorēts saderībai ar B<xz>(1). B<xzdec> nekad neizveido un nedzēš nekādus failus."

#. type: Plain text
#: ../src/xzdec/xzdec.1
msgid "Ignored for B<xz>(1)  compatibility.  B<xzdec> always writes the decompressed data to standard output."
msgstr "Ignorēts saderībai ar B<xz>(1). B<xzdec> vienmēr raksta atspiestos datus standarta izvadē."

#. type: Plain text
#: ../src/xzdec/xzdec.1
msgid "Specifying this once does nothing since B<xzdec> never displays any warnings or notices.  Specify this twice to suppress errors."
msgstr "Šī parametra norādīšana vienreiz neko nedara, jo B<xzdec> nekad nerāda brīdinājumus vai paziņojumus. Norādiet to divreiz, lai apspiestu kļūdas."

#. type: Plain text
#: ../src/xzdec/xzdec.1
msgid "Ignored for B<xz>(1)  compatibility.  B<xzdec> never uses the exit status 2."
msgstr "Ignorēts saderībai ar B<xz>(1). B<xzdec> nekad neizmanto izejas statusu 2."

#. type: Plain text
#: ../src/xzdec/xzdec.1
msgid "Display a help message and exit successfully."
msgstr "Parādīt palīdzības ziņojumu un veiksmīgi iziet."

#. type: Plain text
#: ../src/xzdec/xzdec.1
msgid "Display the version number of B<xzdec> and liblzma."
msgstr "Parādīt B<xzdec> un liblzma versijas numuru."

#. type: Plain text
#: ../src/xzdec/xzdec.1
msgid "All was good."
msgstr "Viss bija kārtībā."

#. type: Plain text
#: ../src/xzdec/xzdec.1
msgid "B<xzdec> doesn't have any warning messages like B<xz>(1)  has, thus the exit status 2 is not used by B<xzdec>."
msgstr "B<xzdec> nav nekādu brīdinājuma ziņojumu, kādi ir B<xz>(1), tāpēc B<xzdec> neizmanto izejas statusu 2."

#. type: Plain text
#: ../src/xzdec/xzdec.1
msgid "Use B<xz>(1)  instead of B<xzdec> or B<lzmadec> for normal everyday use.  B<xzdec> or B<lzmadec> are meant only for situations where it is important to have a smaller decompressor than the full-featured B<xz>(1)."
msgstr "Parastai ikdienas lietošanai B<xzdec> vai B<lzmadec> vietā izmantojiet B<xz>(1). B<xzdec> vai B<lzmadec> ir paredzēti tikai situācijām, kurās ir svarīgi, lai atspiedējs būtu mazāks nekā pilnas funkcionalitātes B<xz>(1)."

#. type: Plain text
#: ../src/xzdec/xzdec.1
msgid "B<xzdec> and B<lzmadec> are not really that small.  The size can be reduced further by dropping features from liblzma at compile time, but that shouldn't usually be done for executables distributed in typical non-embedded operating system distributions.  If you need a truly small B<.xz> decompressor, consider using XZ Embedded."
msgstr "B<xzdec> un B<lzmadec> patiesībā nav nemaz tik mazi. Izmēru var samazināt vēl vairāk, kompilēšanas laikā izslēdzot liblzma iespējas, taču to parasti nevajadzētu darīt izpildāmajiem failiem, kas tiek izplatīti tipiskos neiegulto operētājsistēmu distributīvos. Ja nepieciešams patiesi mazs B<.xz> atspiedējs, apsveriet iespēju izmantot XZ Embedded."

#. type: Plain text
#: ../src/xzdec/xzdec.1 ../src/lzmainfo/lzmainfo.1
msgid "B<xz>(1)"
msgstr "B<xz>(1)"

#. type: TH
#: ../src/lzmainfo/lzmainfo.1
#, no-wrap
msgid "LZMAINFO"
msgstr "LZMAINFO"

#. type: TH
#: ../src/lzmainfo/lzmainfo.1
#, no-wrap
msgid "2013-06-30"
msgstr "2013-06-30"

#. type: Plain text
#: ../src/lzmainfo/lzmainfo.1
msgid "lzmainfo - show information stored in the .lzma file header"
msgstr "lzmainfo - parādīt informāciju, kas saglabāta .lzma faila galvenē"

#. type: Plain text
#: ../src/lzmainfo/lzmainfo.1
msgid "B<lzmainfo> [B<--help>] [B<--version>] [I<file...>]"
msgstr "B<lzmainfo> [B<--help>] [B<--version>] [I<fails...>]"

#. type: Plain text
#: ../src/lzmainfo/lzmainfo.1
msgid "B<lzmainfo> shows information stored in the B<.lzma> file header.  It reads the first 13 bytes from the specified I<file>, decodes the header, and prints it to standard output in human readable format.  If no I<files> are given or I<file> is B<->, standard input is read."
msgstr "B<lzmainfo> parāda informāciju, kas saglabāta B<.lzma> faila galvenē. Tas nolasa pirmos 13 baitus no norādītā I<failu>, dekodē galveni un izvada to standarta izvadē cilvēkam lasāmā formātā. Ja nav norādīts nevieni I<faili> vai I<fails> ir B<->, tiek lasīta standarta ievade."

#. type: Plain text
#: ../src/lzmainfo/lzmainfo.1
msgid "Usually the most interesting information is the uncompressed size and the dictionary size.  Uncompressed size can be shown only if the file is in the non-streamed B<.lzma> format variant.  The amount of memory required to decompress the file is a few dozen kilobytes plus the dictionary size."
msgstr "Parasti interesantākā informācija ir nesaspiestais izmērs un vārdnīcas izmērs. Nesaspiesto izmēru var parādīt tikai tad, ja fails ir nestraumētā B<.lzma> formāta variantā. Atmiņas apjoms, kas nepieciešams faila atspiešanai, ir daži desmiti kilobaitu plus vārdnīcas izmērs."

#. type: Plain text
#: ../src/lzmainfo/lzmainfo.1
msgid "B<lzmainfo> is included in XZ Utils primarily for backward compatibility with LZMA Utils."
msgstr "B<lzmainfo> ir iekļauts XZ Utils galvenokārt, lai nodrošinātu atpakaļsaderību ar LZMA Utils."

#. type: SH
#: ../src/lzmainfo/lzmainfo.1
#, no-wrap
msgid "BUGS"
msgstr "KĻŪDAS"

#. type: Plain text
#: ../src/lzmainfo/lzmainfo.1
msgid "B<lzmainfo> uses B<MB> while the correct suffix would be B<MiB> (2^20 bytes).  This is to keep the output compatible with LZMA Utils."
msgstr "B<lzmainfo> izmanto B<MB>, lai gan pareizais sufikss būtu B<MiB> (2^20 baiti). Tas ir darīts, lai saglabātu izvadi saderīgu ar LZMA Utils."

#. type: TH
#: ../src/scripts/xzdiff.1
#, no-wrap
msgid "XZDIFF"
msgstr "XZDIFF"

#. type: TH
#: ../src/scripts/xzdiff.1 ../src/scripts/xzgrep.1 ../src/scripts/xzless.1
#: ../src/scripts/xzmore.1
#, no-wrap
msgid "2025-03-06"
msgstr "2025-03-06"

#. type: Plain text
#: ../src/scripts/xzdiff.1
msgid "xzcmp, xzdiff, lzcmp, lzdiff - compare compressed files"
msgstr "xzcmp, xzdiff, lzcmp, lzdiff - salīdzināt saspiestos failus"

#. type: Plain text
#: ../src/scripts/xzdiff.1
msgid "B<xzcmp> [I<option...>] I<file1> [I<file2>]"
msgstr "B<xzcmp> [I<option...>] I<fails1> [I<fails2>]"

#. type: Plain text
#: ../src/scripts/xzdiff.1
msgid "B<xzdiff> \\&..."
msgstr "B<xzdiff> \\&..."

#. type: Plain text
#: ../src/scripts/xzdiff.1
msgid "B<lzcmp> \\&...  (DEPRECATED)"
msgstr "B<lzcmp> \\&...  (NOVECOJIS)"

#. type: Plain text
#: ../src/scripts/xzdiff.1
msgid "B<lzdiff> \\&...  (DEPRECATED)"
msgstr "B<lzdiff> \\&...  (NOVECOJIS)"

#. type: Plain text
#: ../src/scripts/xzdiff.1
msgid "B<xzcmp> and B<xzdiff> compare uncompressed contents of two files.  Uncompressed data and options are passed to B<cmp>(1)  or B<diff>(1)  unless B<--help> or B<--version> is specified."
msgstr "B<xzcmp> un B<xzdiff> salīdzina divu failu nesaspiesto saturu. Nesaspiestie dati un opcijas tiek nodoti B<cmp>(1) vai B<diff>(1), ja vien nav norādīts B<--help> vai B<--version>."

#. type: Plain text
#: ../src/scripts/xzdiff.1
msgid "If both I<file1> and I<file2> are specified, they can be uncompressed files or files in formats that B<xz>(1), B<gzip>(1), B<bzip2>(1), B<lzop>(1), B<zstd>(1), or B<lz4>(1)  can decompress.  The required decompression commands are determined from the filename suffixes of I<file1> and I<file2>.  A file with an unknown suffix is assumed to be either uncompressed or in a format that B<xz>(1)  can decompress."
msgstr "Ja ir norādīti gan I<fails1>, gan I<fails2>, tie var būt nesaspiesti faili vai faili formātos, kurus var atspiest B<xz>(1), B<gzip>(1), B<bzip2>(1), B<lzop>(1), B<zstd>(1) vai B<lz4>(1). Nepieciešamās atspiešanas komandas tiek noteiktas pēc I<fails1> un I<fails2> faila nosaukuma paplašinājumiem. Ja failam ir nezināms paplašinājums, tiek pieņemts, ka tas ir vai nu nesaspiests, vai formātā, kuru spēj atspiest B<xz>(1)."

#. type: Plain text
#: ../src/scripts/xzdiff.1
msgid "If only one filename is provided, I<file1> must have a suffix of a supported compression format and the name for I<file2> is assumed to be I<file1> with the compression format suffix removed."
msgstr "Ja ir norādīts tikai viens faila nosaukums, I<fails1> ir jābūt ar atbalstīta saspiešanas formāta paplašinājumu, un par I<fails2> nosaukumu tiek pieņemts I<fails1> ar noņemtu saspiešanas formāta paplašinājumu."

#. type: Plain text
#: ../src/scripts/xzdiff.1
msgid "The commands B<lzcmp> and B<lzdiff> are provided for backward compatibility with LZMA Utils.  They are deprecated and will be removed in a future version."
msgstr "Komandas B<lzcmp> un B<lzdiff> ir nodrošinātas atpakaļsavietojamībai ar LZMA Utils. Tās ir novecojušas un nākotnes versijā tiks noņemtas."

#. type: Plain text
#: ../src/scripts/xzdiff.1
msgid "If a decompression error occurs, the exit status is B<2>.  Otherwise the exit status of B<cmp>(1)  or B<diff>(1)  is used."
msgstr "Ja rodas atspiešanas kļūda, izpildes statuss ir B<2>. Pretējā gadījumā tiek izmantots B<cmp>(1) vai B<diff>(1) izpildes statuss."

#. type: Plain text
#: ../src/scripts/xzdiff.1
msgid "B<cmp>(1), B<diff>(1), B<xz>(1), B<gzip>(1), B<bzip2>(1), B<lzop>(1), B<zstd>(1), B<lz4>(1)"
msgstr "B<cmp>(1), B<diff>(1), B<xz>(1), B<gzip>(1), B<bzip2>(1), B<lzop>(1), B<zstd>(1), B<lz4>(1)"

#. type: TH
#: ../src/scripts/xzgrep.1
#, no-wrap
msgid "XZGREP"
msgstr "XZGREP"

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "xzgrep - search possibly-compressed files for patterns"
msgstr "xzgrep - meklēt paraugus iespējami saspiestos failos"

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "B<xzgrep> [I<option...>] [I<pattern_list>] [I<file...>]"
msgstr "B<xzgrep> [I<option...>] [I<pattern_list>] [I<file...>]"

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "B<xzegrep> \\&..."
msgstr "B<xzegrep> \\&..."

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "B<xzfgrep> \\&..."
msgstr "B<xzfgrep> \\&..."

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "B<lzgrep> \\&...  (DEPRECATED)"
msgstr "B<lzgrep> \\&...  (NOVECOJIS)"

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "B<lzegrep> \\&...  (DEPRECATED)"
msgstr "B<lzegrep> \\&...  (NOVECOJIS)"

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "B<lzfgrep> \\&...  (DEPRECATED)"
msgstr "B<lzfgrep> \\&...  (NOVECOJIS)"

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "B<xzgrep> invokes B<grep>(1)  on uncompressed contents of files.  The formats of the I<files> are determined from the filename suffixes.  Any I<file> with a suffix supported by B<xz>(1), B<gzip>(1), B<bzip2>(1), B<lzop>(1), B<zstd>(1), or B<lz4>(1)  will be decompressed; all other files are assumed to be uncompressed."
msgstr "B<xzgrep> izsauc B<grep>(1) nesaspiestam failu saturam. I<failu> formāti tiek noteikti pēc failu nosaukumu paplašinājumiem. Jebkurš I<fails> ar paplašinājumu, ko atbalsta B<xz>(1), B<gzip>(1), B<bzip2>(1), B<lzop>(1), B<zstd>(1) vai B<lz4>(1), tiks atspiests; visi pārējie faili tiek uzskatīti par nesaspiestiem."

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "If no I<files> are specified or I<file> is B<-> then standard input is read.  When reading from standard input, only files supported by B<xz>(1)  are decompressed.  Other files are assumed to be in uncompressed form already."
msgstr "Ja nav norādīti I<faili> vai I<fails> ir B<->, tad tiek lasīta standarta ievade. Lasot no standarta ievades, tiek atspiesti tikai tie faili, ko atbalsta B<xz>(1). Pārējie faili tiek uzskatīti par jau nesaspiestiem."

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "Most I<options> of B<grep>(1)  are supported.  However, the following options are not supported:"
msgstr "Tiek atbalstīta lielākā daļa B<grep>(1) I<opciju>. Tomēr šādas opcijas netiek atbalstītas:"

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "B<-r>, B<--recursive>"
msgstr "B<-r>, B<--recursive>"

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "B<-R>, B<--dereference-recursive>"
msgstr "B<-R>, B<--dereference-recursive>"

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "B<-d>, B<--directories=>I<action>"
msgstr "B<-d>, B<--directories=>I<action>"

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "B<-Z>, B<--null>"
msgstr "B<-Z>, B<--null>"

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "B<-z>, B<--null-data>"
msgstr "B<-z>, B<--null-data>"

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "B<--include=>I<glob>"
msgstr "B<--include=>I<glob>"

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "B<--exclude=>I<glob>"
msgstr "B<--exclude=>I<glob>"

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "B<--exclude-from=>I<file>"
msgstr "B<--exclude-from=>I<file>"

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "B<--exclude-dir=>I<glob>"
msgstr "B<--exclude-dir=>I<glob>"

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "B<xzegrep> is an alias for B<xzgrep -E>.  B<xzfgrep> is an alias for B<xzgrep -F>."
msgstr "B<xzegrep> ir aizstājvārds komandai B<xzgrep -E>. B<xzfgrep> ir aizstājvārds komandai B<xzgrep -F>."

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "The commands B<lzgrep>, B<lzegrep>, and B<lzfgrep> are provided for backward compatibility with LZMA Utils.  They are deprecated and will be removed in a future version."
msgstr "Komandas B<lzgrep>, B<lzegrep> un B<lzfgrep> ir nodrošinātas atpakaļsaderībai ar LZMA Utils. Tās ir novecojušas un tiks noņemtas kādā no nākamajām versijām."

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "At least one match was found from at least one of the input files.  No errors occurred."
msgstr "Vismaz vienā no ievades failiem tika atrasta vismaz viena atbilstība. Kļūdas neradās."

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "No matches were found from any of the input files.  No errors occurred."
msgstr "Nevienā no ievades failiem netika atrasta neviena atbilstība. Kļūdas neradās."

#. type: TP
#: ../src/scripts/xzgrep.1
#, no-wrap
msgid "E<gt>1"
msgstr "E<gt>1"

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "One or more errors occurred.  It is unknown if matches were found."
msgstr "Radās viena vai vairākas kļūdas. Nav zināms, vai tika atrastas atbilstības."

#. type: TP
#: ../src/scripts/xzgrep.1
#, no-wrap
msgid "B<GREP>"
msgstr "B<GREP>"

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "If B<GREP> is set to a non-empty value, it is used instead of B<grep>, B<grep -E>, or B<grep -F>."
msgstr "Ja B<GREP> ir iestatīts uz netukšu vērtību, tā tiek izmantota B<grep>, B<grep -E> vai B<grep -F> vietā."

#. type: Plain text
#: ../src/scripts/xzgrep.1
msgid "B<grep>(1), B<xz>(1), B<gzip>(1), B<bzip2>(1), B<lzop>(1), B<zstd>(1), B<lz4>(1), B<zgrep>(1)"
msgstr "B<grep>(1), B<xz>(1), B<gzip>(1), B<bzip2>(1), B<lzop>(1), B<zstd>(1), B<lz4>(1), B<zgrep>(1)"

#. type: TH
#: ../src/scripts/xzless.1
#, no-wrap
msgid "XZLESS"
msgstr "XZLESS"

#. type: Plain text
#: ../src/scripts/xzless.1
msgid "xzless, lzless - view xz or lzma compressed (text) files"
msgstr "xzless, lzless - skatīt xz vai lzma saspiestus (teksta) failus"

#. type: Plain text
#: ../src/scripts/xzless.1
msgid "B<xzless> [I<file>...]"
msgstr "B<xzless> [I<file>...]"

#. type: Plain text
#: ../src/scripts/xzless.1
msgid "B<lzless> [I<file>...] (DEPRECATED)"
msgstr "B<lzless> [I<file>...] (NOVECOJIS)"

#. type: Plain text
#: ../src/scripts/xzless.1
msgid "B<xzless> is a filter that displays text from compressed files to a terminal.  Files supported by B<xz>(1)  are decompressed; other files are assumed to be in uncompressed form already.  If no I<files> are given, B<xzless> reads from standard input."
msgstr "B<xzless> ir filtrs, kas attēlo tekstu no saspiestiem failiem terminālī. Faili, kurus atbalsta B<xz>(1), tiek atspiesti; pārējie faili tiek uzskatīti par jau nesaspiestiem. Ja nav norādīti I<faili>, B<xzless> lasa no standarta ievades."

#. type: Plain text
#: ../src/scripts/xzless.1
msgid "B<xzless> uses B<less>(1)  to present its output.  Unlike B<xzmore>, its choice of pager cannot be altered by setting an environment variable.  Commands are based on both B<more>(1)  and B<vi>(1)  and allow back and forth movement and searching.  See the B<less>(1)  manual for more information."
msgstr "B<xzless> izmanto B<less>(1), lai parādītu savu izvadi. Atšķirībā no B<xzmore>, tā lapotāja izvēli nevar mainīt, iestatot vides mainīgo. Komandas ir balstītas gan uz B<more>(1), gan uz B<vi>(1) un ļauj pārvietoties uz priekšu un atpakaļ, kā arī meklēt. Plašāku informāciju skatiet B<less>(1) rokasgrāmatā."

#. type: Plain text
#: ../src/scripts/xzless.1
msgid "The command named B<lzless> is provided for backward compatibility with LZMA Utils.  It is deprecated and will be removed in a future version."
msgstr "Komanda ar nosaukumu B<lzless> ir nodrošināta atpakaļsaderībai ar LZMA Utils. Tā ir novecojusi un tiks noņemta kādā no nākamajām versijām."

#. type: TP
#: ../src/scripts/xzless.1
#, no-wrap
msgid "B<LESSMETACHARS>"
msgstr "B<LESSMETACHARS>"

#. type: Plain text
#: ../src/scripts/xzless.1
msgid "A list of characters special to the shell.  Set by B<xzless> unless it is already set in the environment."
msgstr "Čaulai īpašo rakstzīmju saraksts. To iestata B<xzless>, ja vien tas jau nav iestatīts vidē."

#. type: TP
#: ../src/scripts/xzless.1
#, no-wrap
msgid "B<LESSOPEN>"
msgstr "B<LESSOPEN>"

#. type: Plain text
#: ../src/scripts/xzless.1
msgid "Set to a command line to invoke the B<xz>(1)  decompressor for preprocessing the input files to B<less>(1)."
msgstr "Iestatīts uz komandrindu, lai izsauktu B<xz>(1) atspiedēju ievades failu pirmapstrādei programmai B<less>(1)."

#. type: Plain text
#: ../src/scripts/xzless.1
msgid "B<less>(1), B<xz>(1), B<xzmore>(1), B<zless>(1)"
msgstr "B<less>(1), B<xz>(1), B<xzmore>(1), B<zless>(1)"

#. type: TH
#: ../src/scripts/xzmore.1
#, no-wrap
msgid "XZMORE"
msgstr "XZMORE"

#. type: Plain text
#: ../src/scripts/xzmore.1
msgid "xzmore, lzmore - view xz or lzma compressed (text) files"
msgstr "xzmore, lzmore - skatīt ar xz vai lzma saspiestus (teksta) failus"

#. type: Plain text
#: ../src/scripts/xzmore.1
msgid "B<xzmore> [I<file>...]"
msgstr "B<xzmore> [I<fails>...]"

#. type: Plain text
#: ../src/scripts/xzmore.1
msgid "B<lzmore> [I<file>...] (DEPRECATED)"
msgstr "B<lzmore> [I<fails>...] (NOVECOJIS)"

#. type: Plain text
#: ../src/scripts/xzmore.1
msgid "B<xzmore> displays text from compressed files to a terminal using B<more>(1).  Files supported by B<xz>(1)  are decompressed; other files are assumed to be in uncompressed form already.  If no I<files> are given, B<xzmore> reads from standard input.  See the B<more>(1)  manual for the keyboard commands."
msgstr "B<xzmore> terminālī parāda saspiestu failu tekstu, izmantojot B<more>(1). B<xz>(1) atbalstītie faili tiek atspiesti; tiek pieņemts, ka pārējie faili jau ir nesaspiesti. Ja I<faili> nav norādīti, B<xzmore> lasa no standarta ievades. Tastatūras komandas skatiet B<more>(1) rokasgrāmatā."

#. type: Plain text
#: ../src/scripts/xzmore.1
msgid "Note that scrolling backwards might not be possible depending on the implementation of B<more>(1).  This is because B<xzmore> uses a pipe to pass the decompressed data to B<more>(1).  B<xzless>(1)  uses B<less>(1)  which provides more advanced features."
msgstr "Ņemiet vērā, ka atkarībā no B<more>(1) realizācijas ritināšana atpakaļ var nebūt iespējama. Tas ir tāpēc, ka B<xzmore> izmanto kanālu, lai nodotu atspiestos datus B<more>(1). B<xzless>(1) izmanto B<less>(1), kas nodrošina plašākas iespējas."

#. type: Plain text
#: ../src/scripts/xzmore.1
msgid "The command B<lzmore> is provided for backward compatibility with LZMA Utils.  It is deprecated and will be removed in a future version."
msgstr "Komanda B<lzmore> ir nodrošināta atpakaļsaderībai ar LZMA Utils. Tā ir novecojusi un kādā no nākamajām versijām tiks noņemta."

#.  TRANSLATORS: Don't translate the uppercase PAGER.
#.  It is a name of an environment variable.
#. type: TP
#: ../src/scripts/xzmore.1
#, no-wrap
msgid "B<PAGER>"
msgstr "B<PAGER>"

#. type: Plain text
#: ../src/scripts/xzmore.1
msgid "If B<PAGER> is set, its value is used as the pager instead of B<more>(1)."
msgstr "Ja ir iestatīts B<PAGER>, tā vērtība tiek izmantota kā lapotājs B<more>(1) vietā."

#. type: Plain text
#: ../src/scripts/xzmore.1
msgid "B<more>(1), B<xz>(1), B<xzless>(1), B<zmore>(1)"
msgstr "B<more>(1), B<xz>(1), B<xzless>(1), B<zmore>(1)"
